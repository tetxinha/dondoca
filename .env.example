# Copia este ficheiro para .env e preenche com valores reais.
# NUNCA commits o .env verdadeiro para o Git.

DONDOCA_WEBHOOK_SECRET=escolhe-uma-frase-secreta-longa
DONDOCA_DB_PATH=dondoca.db

# WhatsApp Cloud API (Meta) — ver README para como obter estes valores
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Números autorizados a receber mensagens, em formato internacional só com
# dígitos (ex: 351912345678, sem "+" nem espaços)
WHATSAPP_NUMERO_RITA=
WHATSAPP_NUMERO_MARIDO=

# Nomes dos templates (em revisão na Meta) e idioma (o mesmo para todos)
WHATSAPP_TEMPLATE_LISTA_MERCADO=
WHATSAPP_TEMPLATE_LISTA_CONTINENTE=
WHATSAPP_TEMPLATE_LISTA_TAREFAS=
WHATSAPP_TEMPLATE_LINGUA=pt_PT
